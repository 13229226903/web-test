# ── Allure 截图工具 ──────────────────────────────────────────

@pytest.fixture(autouse=True)
def _set_test_name(request):
    """记录当前测试函数名，供 allure_screenshot 生成唯一文件名。"""
    global _current_test_name
    _current_test_name = request.node.name
    yield
    _current_test_name = None


def allure_screenshot(page, name="截图"):
    """附加截图到 Allure，同时落盘到 data/screenshots/ 供 visual-review agent 读取。

    使用手动 viewport 展开方式代替 full_page=True，因为 full_page=True 会触发
    轮播组件的 resize 事件导致 slide 被重新折叠。
    """
    try:
        # 保存原始 viewport
        orig_vp = page.viewport_size
        # 获取全页高度，手动展开 viewport 避免 full_page 触发 resize 折叠轮播
        page_height = page.evaluate("document.body.scrollHeight")
        page.set_viewport_size({"width": orig_vp["width"], "height": page_height + 100})
        page.wait_for_timeout(500)
        # 强制加载所有未完成的图片（viewport 已展开到全页高，此时重设 src 浏览器会立即请求）
        page.evaluate("""() => {
            document.querySelectorAll('img').forEach(function(img) {
                if (!img.complete || img.naturalWidth === 0) {
                    var s = img.getAttribute('src') || img.src;
                    if (s) { img.removeAttribute('src'); img.setAttribute('src', s); }
                }
            });
        }""")
        page.wait_for_timeout(3000)
        png = page.screenshot(full_page=False)
        # 恢复 viewport
        page.set_viewport_size(orig_vp)
        page.wait_for_timeout(300)
        allure.attach(png, name=name, attachment_type=allure.attachment_type.PNG)
        # 同时落盘，文件名: <测试函数名>_<步骤名>.png
        prefix = f"{_current_test_name}_" if _current_test_name else ""
        safe_name = prefix + name.replace("/", "_").replace("\\", "_").replace(" ", "_")
        filepath = os.path.join(SCREENSHOT_DIR, f"{safe_name}.png")
        with open(filepath, "wb") as f:
            f.write(png)
    except Exception:
        pass


def allure_screenshot_inline(page, name="最终结果"):
    """同 allure_screenshot。保留函数名兼容，所有截图走统一逻辑。"""
    allure_screenshot(page, name)


# ── AI 视觉断言 ──────────────────────────────────────────────

def visual_assert(before_name, after_name, expectation, model=None):
    """调用多模态 API 对比两张截图，返回 verdict: pass/fail/uncertain。

    截图自动从 SCREENSHOT_DIR 按名称前缀匹配，取最新的一张。
    """
    import base64, json, urllib.request, urllib.error
    from helpers.review_api_config import get_review_api_config

    api_key, api_base, resolved_model = get_review_api_config()
    if not api_key:
        return {"verdict": "skipped", "reason": "未配置可用的 LLM API"}

    # 按名称前缀匹配最新的截图文件
    def find_screenshot(name_prefix):
        import glob as _glob
        pattern = os.path.join(SCREENSHOT_DIR, f"*{name_prefix}*.png")
        files = sorted(_glob.glob(pattern), key=os.path.getmtime, reverse=True)
        if not files:
            raise FileNotFoundError(f"找不到匹配 '{name_prefix}' 的截图")
        return files[0]

    try:
        before_path = find_screenshot(before_name)
        after_path = find_screenshot(after_name)
    except FileNotFoundError as e:
        return {"verdict": "error", "reason": str(e)}

    with open(before_path, "rb") as f:
        before_b64 = base64.b64encode(f.read()).decode()
    with open(after_path, "rb") as f:
        after_b64 = base64.b64encode(f.read()).decode()

    if model is None:
        model = resolved_model or "gpt-5.6"

    body = {
        "model": model,
        "max_tokens": 300,
        "messages": [{
            "role": "user",
            "content": [
                {"type": "image_url", "image_url": {"url": f"data:image/png;base64,{before_b64}"}},
                {"type": "text", "text": "这是操作前的截图（作为对比基准）。"},
                {"type": "image_url", "image_url": {"url": f"data:image/png;base64,{after_b64}"}},
                {"type": "text", "text": (
                    f"这是操作后的截图。请判断操作后截图中的视觉效果是否满足以下期望：\n"
                    f"「{expectation}」\n\n"
                    f"回答格式要求：只返回一个 JSON 对象，不要包含任何其他文字：\n"
                    f'{{"verdict": "pass或fail或uncertain", "reason": "一句话说明判断依据（中文）"}}'
                )},
            ]
        }]
    }

    req = urllib.request.Request(
        f"{api_base}/chat/completions",
        data=json.dumps(body).encode("utf-8"),
        headers={"Authorization": f"Bearer {api_key}", "Content-Type": "application/json"},
    )

    import time as _time
    last_err = None
    text = None
    for attempt in range(3):
        try:
            with urllib.request.urlopen(req, timeout=120) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                text = data["choices"][0]["message"]["content"]
                break
        except urllib.error.HTTPError as e:
            last_err = f"API HTTP {e.code}: {e.read().decode()[:300]}"
            break  # HTTP 错误不重试
        except Exception as e:
            last_err = str(e)
            if "SSL" in last_err:
                _time.sleep(3)  # SSL 错误等 3s 重试
                continue
            break  # 其他错误不重试
    else:
        return {"verdict": "skipped", "reason": f"API 不可用(重试3次): {last_err}"}

    # API 因 HTTP/其它错误 break 出循环但未取到内容时，降级为 skipped（避免 UnboundLocalError）
    if text is None:
        return {"verdict": "skipped", "reason": f"API 调用失败: {last_err}"}

    # 解析 verdict JSON
    cleaned = text.strip()
    if "```" in cleaned:
        parts = cleaned.split("```")
        cleaned = parts[1] if len(parts) > 1 else parts[0]
        if cleaned.startswith("json"):
            cleaned = cleaned[4:]
    try:
        result = json.loads(cleaned.strip())
    except json.JSONDecodeError:
        lower = text.lower()
        if "pass" in lower and "fail" not in lower:
            result = {"verdict": "pass", "reason": text.strip()}
        elif "fail" in lower:
            result = {"verdict": "fail", "reason": text.strip()}
        else:
            result = {"verdict": "uncertain", "reason": f"无法解析: {text[:200]}"}

    # 附加到 Allure 报告
    allure.attach(
        json.dumps(result, ensure_ascii=False, indent=2),
        name=f"AI 视觉审查: {expectation[:30]}",
        attachment_type=allure.attachment_type.JSON,
    )
    return result


@pytest.hookimpl(tryfirst=True, hookwrapper=True)
def pytest_runtest_makereport(item, call):
    """捕获测试结果。"""
    outcome = yield
    rep = outcome.get_result()
    setattr(item, "rep_" + rep.when, rep)


@pytest.fixture(autouse=True)
def _allure_screenshot_after_test(request):
    """每个测试结束后自动截图附加到 Allure（无论成功失败）。"""
    yield

    if hasattr(request.node, "rep_call"):
        page = None
        for fixture_name in ["session_page", "page"]:
            try:
                page = request.node.funcargs.get(fixture_name)
                if page:
                    break
            except Exception:
                pass

        if page and request.node.rep_call.passed:
            allure_screenshot(page, "测试通过-页面状态")
        elif page and request.node.rep_call.failed:
            allure_screenshot(page, "测试失败-页面状态")
