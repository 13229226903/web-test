"""pytest-playwright 公共 fixture。

pytest-playwright 自带 `page` / `browser` 等 fixture，并通过 `--base-url`
（见 pytest.ini）提供 `base_url` fixture。

登录策略:
- 函数级 `logged_in_page`: 每个测试独立登录（旧逻辑，保留兼容）
- 会话级 `session_page`: 全局登录一次，所有测试复用（推荐，避免限流）
"""

import pytest


@pytest.fixture(scope="session")
def browser_context_args(browser_context_args):
    """覆盖 pytest-playwright 默认的 browser context 参数，
    确保 Vue 组件的文件选择器能被 Playwright 正确拦截，
    绕过系统代理直连测试服务器。"""
    return {
        **browser_context_args,
        "viewport": {"width": 1920, "height": 1080},
        "locale": "en-US",
    }



import pytest
import os
import allure
import struct
import zlib

# 从 .env 文件加载环境变量（无需 python-dotenv）
_env_path = os.path.join(os.path.dirname(__file__), ".env")
if os.path.exists(_env_path):
    with open(_env_path, "r", encoding="utf-8") as _f:
        for _line in _f:
            _line = _line.strip()
            if _line and not _line.startswith("#") and "=" in _line:
                _key, _val = _line.split("=", 1)
                if _key not in os.environ:
                    os.environ[_key] = _val

# 确保 allure-results 目录存在（pytest.ini --alluredir 需要）
os.makedirs("reports/allure-results", exist_ok=True)
os.makedirs("reports/allure-report", exist_ok=True)

# 截图落盘目录，供 visual-review agent 读取
SCREENSHOT_DIR = os.path.join(os.path.dirname(__file__), "data", "screenshots")
os.makedirs(SCREENSHOT_DIR, exist_ok=True)

# 当前测试名（由 _set_test_name fixture 注入），用于截图文件前缀
_current_test_name = None





# ── 辅助: 关闭定价弹窗 ──────────────────────────────────────

def dismiss_pricing_overlay(page):
    """关闭 /create 页面的定价弹窗遮罩（JS 强制删除）。"""
    page.evaluate("""() => {
        document.querySelectorAll('div[class*="fixed"]').forEach(o => {
            const bg = window.getComputedStyle(o).backgroundColor;
            if (bg && bg.includes('rgba') && (bg.includes('0.3') || bg.includes('0.5'))) {
                o.remove();
            }
        });
    }""")
    page.wait_for_timeout(1000)


def _dismiss_login_popup_if_present(page):
    """如果页面当前弹出了登录相关浮层，尽量直接关闭。"""
    page.evaluate("""() => {
        const norm = (value) => (value || '').replace(/\\s+/g, ' ').trim().toLowerCase();
        const visible = (el) => {
            if (!el) return false;
            const style = window.getComputedStyle(el);
            if (!style || style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return false;
            const rect = el.getBoundingClientRect();
            return rect.width > 0 && rect.height > 0;
        };

        const dialogs = Array.from(document.querySelectorAll(
            '[role="dialog"], dialog[open], [aria-modal="true"], [class*="modal"], [class*="popup"], [class*="dialog"]'
        )).filter(visible);

        const loginLike = dialogs.find((el) => {
            const text = norm(el.textContent);
            return text.includes('log in') || text.includes('sign in') || text.includes('verification code') || text.includes('email');
        });

        const target = loginLike || dialogs[0];
        if (!target) return false;

        const closeBtn = Array.from(target.querySelectorAll('button, [role="button"], [aria-label]')).find((el) => {
            const text = norm(el.textContent) || norm(el.getAttribute('aria-label'));
            return text === 'close' || text === 'cancel' || text.includes('close') || text.includes('dismiss') || text.includes('x');
        });

        if (closeBtn && typeof closeBtn.click === 'function') {
            closeBtn.click();
            return true;
        }

        const esc = new KeyboardEvent('keydown', {key: 'Escape', code: 'Escape', bubbles: true});
        document.dispatchEvent(esc);
        return true;
    }""")
    page.wait_for_timeout(1000)


# ═══════════════════════════════════════════════════════════════
# 会话级登录（推荐）— 全局只登录一次
# ═══════════════════════════════════════════════════════════════

@pytest.fixture(scope="session")
def session_context(browser, playwright):
    """会话级 fixture: 创建共享 browser context → 登录一次。
    browser 和 playwright 是 pytest-playwright 的 session 级 fixture，
    我们在此之上创建一个持久 context 并完成登录，后续所有测试复用。
    """
    from playwright.sync_api import expect as pw_expect

    email = os.environ.get("POKECUT_TEST_EMAIL", "450832596@qq.com")
    code = os.environ.get("POKECUT_TEST_CODE", "123456")

    # 使用 pytest-playwright 已启动的 browser，创建持久 context
    context = browser.new_context(
        viewport={"width": 1920, "height": 1080},
        locale="en-US",
    )
    page = context.new_page()

    # ── 只登录一次 ──
    page.goto("http://10.17.1.66:3001", timeout=120000)
    page.wait_for_timeout(5000)

    # 点击右上角 Log in → 弹出登录弹窗
    page.get_by_text("Log in", exact=True).first.click()
    page.wait_for_timeout(3000)
    page.screenshot(path="data/debug/login_modal.png")

    # 弹窗已直接显示登录表单，填邮箱和验证码
    email_input = page.locator('input[type="email"]')
    pw_expect(email_input).to_be_visible(timeout=10000)
    email_input.fill(email)
    print("[conftest] 邮箱已填写")

    code_input = page.locator('input[placeholder="Verification Code"]')
    pw_expect(code_input).to_be_visible(timeout=5000)
    code_input.fill(code)
    print("[conftest] 验证码已填写")
    page.screenshot(path="data/debug/login_form_filled.png")

    # 提交登录（用 dispatchEvent 触发 Vue 事件处理器，Playwright click 不生效）
    page.evaluate("""() => {
        const btns = document.querySelectorAll('button');
        for (const b of btns) {
            if (b.textContent.trim() === 'Log in' && b.offsetWidth > 200) {
                b.dispatchEvent(new MouseEvent('click', {bubbles: true, cancelable: true}));
                return;
            }
        }
    }""")
    page.wait_for_timeout(10000)

    # 关闭可能出现的 VIP 弹窗
    page.evaluate("""() => {
        document.querySelectorAll('div[class*="fixed"]').forEach(o => {
            const bg = window.getComputedStyle(o).backgroundColor;
            if (bg && bg.includes('rgba') && (bg.includes('0.3') || bg.includes('0.5'))) {
                o.remove();
            }
        });
    }""")
    page.wait_for_timeout(2000)

    # 如果登录弹窗仍在，直接尝试关闭，不阻塞后续测试
    _dismiss_login_popup_if_present(page)

    # 确认登录成功 — 打印页面状态辅助诊断
    body_text = page.locator("body").inner_text()[:500]
    print(f"\n[conftest] 登录后页面内容: {body_text[:300]}")

    try:
        pw_expect(page.locator("text='User8JY'").first).to_be_visible(timeout=15000)
        print(f"\n[conftest] 全局登录成功")
    except Exception:
        page.screenshot(path="data/debug/login_failure.png", full_page=True)
        print(f"\n[conftest] 登录标识未出现，已关闭可能的弹窗并继续: {page.url}")

    page.close()  # 关闭临时 login page

    yield context

    context.close()


@pytest.fixture
def session_page(session_context):
    """从 session_context 创建新 page — 继承了登录态（cookies/localStorage）。

    每个测试函数调用此 fixture 获得独立 page，但共享同一个登录会话。
    """
    page = session_context.new_page()
    yield page
    page.close()


@pytest.fixture
def standalone_page(playwright):
    """独立 chromium page — 绕过 pytest-playwright 的 browser 管理，
    直接从 playwright fixture 启动新的 chromium 实例。

    pytest-playwright 的 browser fixture 在 Vue 交互上存在差异，
    直接 chromium.launch() 模拟 standalone 脚本环境。
    """
    browser = playwright.chromium.launch()
    ctx = browser.new_context(
        viewport={"width": 1920, "height": 1080},
        locale="en-US",
    )
    page = ctx.new_page()
    yield page
    ctx.close()
    browser.close()


